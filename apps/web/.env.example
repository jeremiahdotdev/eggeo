# Next.js web app

# Required in production. Local development falls back to an internal default if omitted.
AUTH_SECRET="change-me-to-a-long-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required to render Google Maps in the locator and nearby eggs views.
NEXT_PUBLIC_MAPS_API_KEY=""

NEXT_PUBLIC_MAX_EGGS_PER_USER="200"
