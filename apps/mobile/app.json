{
  "expo": {
    "name": "Eggeo",
    "slug": "eggeo-mobile",
    "version": "1.0.0",
    "description": "A real-world egg hunt app for events, QR codes, maps, and leaderboards.",
    "orientation": "portrait",
    "scheme": "eggeo",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "dev.jeremiah.eggeo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Eggeo uses the camera to scan egg QR codes.",
        "NSLocationWhenInUseUsageDescription": "Eggeo uses your location to hide eggs and show nearby eggs on the map."
      },
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "dev.jeremiah.eggeo",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Eggeo uses the camera to scan egg QR codes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ]
  }
}
