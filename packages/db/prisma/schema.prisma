datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_PRISMA_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Egg {
  id          String    @id @default(uuid())
  coords      Location?
  description String?
  title       String?
  color       String?
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  username    String?
  points      Int?      @default(1)
  createdBy   User?     @relation(fields: [username], references: [username])
  foundBy     UserEgg[]
  isCollected Boolean? @default(false)
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  username    String
  createdBy   User        @relation(fields: [username], references: [username])
  eggs        Egg[]
  members     UserEvent[]
  createdAt   DateTime    @default(now())
}

model UserEvent {
  username String
  eventId  String
  Event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User     User   @relation(fields: [username], references: [username])

  @@id([username, eventId])
}

model UserEgg {
  username String
  eggId    String
  Egg      Egg    @relation(fields: [eggId], references: [id])
  User     User   @relation(fields: [username], references: [username])

  @@id(name: "id", [username, eggId])
}

model User {
  username     String    @id @default(uuid())
  email        String?   @unique
  passwordHash String?
  name         String?
  foundEggs    UserEgg[]
  hiddenEggs   Egg[]
  events       Event[]
  joinedEvents UserEvent[]
}

model Location {
  eggId String  @id
  egg   Egg     @relation(fields: [eggId], references: [id])
  lat   Decimal
  lng   Decimal
}
